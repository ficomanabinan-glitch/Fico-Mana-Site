# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Never expose through NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Admin authorization / routing
ADMIN_HOSTNAME=admin.ficomana.com
ADMIN_ENFORCE_SUBDOMAIN=false
# Optional server-only bootstrap allowlist; prefer Supabase app_metadata.role=admin.
ADMIN_EMAILS=

# Distributed login rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LOGIN_RATE_LIMIT_SECRET=

# Login audit hashing. If omitted, SUPABASE_SECRET_KEY is used as the salt.
LOGIN_AUDIT_HASH_SECRET=

# Login security alerts
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_SECURITY_EMAIL=
