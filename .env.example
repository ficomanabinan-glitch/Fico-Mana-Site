# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Never expose through NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
# Legacy deployments only; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL used in client emails and portal links
NEXT_PUBLIC_SITE_URL=https://www.ficomana.com

# Admin authorization / routing
ADMIN_HOSTNAME=admin.ficomana.com
EDITOR_HOSTNAME=editor.ficomana.com
ADMIN_ENFORCE_SUBDOMAIN=true
EDITOR_ENFORCE_SUBDOMAIN=true
# Existing active studio membership is required. Bootstrap never recreates members.
# Keep disabled after initial administrator claim provisioning.
ALLOW_ADMIN_EMAIL_BOOTSTRAP=false
ADMIN_EMAILS=
ALLOW_LOCAL_FILE_STORE=false

# Distributed login rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LOGIN_RATE_LIMIT_SECRET=
SECURITY_HASH_SECRET=
# Comma-separated exact HTTPS origins allowed to submit state-changing requests.
SECURITY_ALLOWED_ORIGINS=https://www.ficomana.com,https://ficomana.com,https://admin.ficomana.com,https://editor.ficomana.com

# Login audit hashing. SECURITY_HASH_SECRET is used when this is omitted.
LOGIN_AUDIT_HASH_SECRET=

# Client portal signing. Generate an independent value with at least 32 random bytes.
PORTAL_SIGNING_SECRET=

# Google Drive OAuth. These values are server-only and must never use NEXT_PUBLIC_*.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_DRIVE_ALLOWED_EMAIL=ficomanabinan@gmail.com

# Optional external malware-scanning service. When absent, uploads still receive
# extension, MIME, magic-byte, decode, size, and path validation but are not
# represented as malware-scanned.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=

# Login security alerts
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_SECURITY_EMAIL=
